/dts-v1/;
/ {
    description = "ePass kernel boot bundle";
    #address-cells = <1>;
    images {
        kernel {
            description = "Linux zImage";
            data = /incbin/("./zImage");
            type = "kernel";
            arch = "arm";
            os = "linux";
            compression = "none";
            load = <0x80008000>;
            entry = <0x80008000>;
        };
    };
};
