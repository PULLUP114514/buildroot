 }
 
 /*
@@ -310,7 +316,7 @@ static int do_srgn_splash(struct cmd_tbl *cmdtp, int flag, int argc,
 		(struct sunxi_lcdc_reg *)SUNXI_LCD0_BASE;
 	struct srgn_timing t;
 	unsigned long dtbaddr, fbaddr;
-	bool swap_b_r;
+	bool swap_b_r, has_de;
 	int div;
 
 	dtbaddr = argc > 1 ? simple_strtoul(argv[1], NULL, 16) :
@@ -323,7 +329,7 @@ static int do_srgn_splash(struct cmd_tbl *cmdtp, int flag, int argc,
 		return CMD_RET_FAILURE;
 	}
 
-	if (srgn_get_timing((void *)dtbaddr, &t, &swap_b_r)) {
+	if (srgn_get_timing((void *)dtbaddr, &t, &swap_b_r, &has_de)) {
 		printf("srgn: no srgn,panel-timing, skipping splash\n");
 		return 0;
 	}
@@ -342,7 +348,7 @@ static int do_srgn_splash(struct cmd_tbl *cmdtp, int flag, int argc,
 
 	srgn_de_clocks_on();
 	srgn_debe_setup(fbaddr, t.dt.hactive.typ, t.dt.vactive.typ);
-	srgn_lcd_pinmux();
