@@ -188,6 +191,9 @@ static void srgn_lcd_pinmux(void)
 
 	for (i = 0; i < ARRAY_SIZE(pins); i++)
 		sunxi_gpio_set_cfgpin(SUNXI_GPD(pins[i]), SUNXI_GPD_LCD0);
+
