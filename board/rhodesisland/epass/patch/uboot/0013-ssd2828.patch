index b8d69833..6110f47d 100644
--- a/board/sunxi/srgn_splash.c
+++ b/board/sunxi/srgn_splash.c
@@ -42,7 +42,7 @@ struct srgn_timing {
 };
 
 static int srgn_get_timing(const void *blob, struct srgn_timing *t,
-			   bool *swap_b_r)
+			   bool *swap_b_r, bool *has_de)
 {
 	const fdt32_t *v;
 	int node, len;
@@ -74,6 +74,8 @@ static int srgn_get_timing(const void *blob, struct srgn_timing *t,
 					     "allwinner,suniv-f1c100s-tcon");
 	*swap_b_r = node >= 0 &&
 		    fdt_getprop(blob, node, "srgn,swap-b-r", NULL);
+	*has_de = node >= 0 &&
+		  fdt_getprop(blob, node, "srgn,has-de", NULL);
 	return 0;
 }
 
@@ -178,9 +180,10 @@ static void srgn_debe_start(void)
 
 /*
  * Kernel lcd_rgb565_no_de_pins, 19 pads. Do NOT blanket-mux PD0..PD27
- * like sunxi_display.c: PD19 is the initseq SCL, PD0/PD12 are not LCD.
