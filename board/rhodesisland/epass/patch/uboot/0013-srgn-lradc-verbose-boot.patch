+config SRGN_LRADC
+	bool "init_sun4i_lradc / chk_verbose_boot for suniv KEYADC"
+	depends on MACH_SUNIV
+	help
+	  Adds init_sun4i_lradc (enable F1C100s LRADC @ 0x01c23400 with a
