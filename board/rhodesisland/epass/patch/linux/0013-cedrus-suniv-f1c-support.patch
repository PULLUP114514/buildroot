From: Shirogane Tsumugi <artoriapendragon123@gmail.com>
Subject: [PATCH] media: cedrus: add suniv F1C100s/F1C200s support

Verified on F1C200s: MPEG2 and H264 (baseline/all-I/High) decode
correctly, zero-copy display through DEFE (sun4i frontend,
DRM_FORMAT_MOD_ALLWINNER_TILED). 480p decode runs at 4-6 ms/frame
with the VE at 297 MHz.

suniv VE reports version 0x16630040 (a cut-down A31-gen IP; BSP IC id
0x1663). Probed on silicon: MACC_VE_OUTPUT_FORMAT (0xEC) and
MACC_VE_EXTRA_OUT_FMT_OFFSET (0xE8) are both RAZ/WI, so there is no
linear (untiled) output at all - the variant has no
CEDRUS_CAPABILITY_UNTILED and only outputs V4L2_PIX_FMT_SUNXI_TILED_NV12.

Contains, squashed:

1. suniv variant + compatible, mod_rate 297 MHz (pll-ve exact frac
   rate); ve_clk gate gets CLK_SET_RATE_PARENT so the rate reaches
   pll-ve instead of being a silent no-op.

2. CEDRUS_QUIRK_NO_DDR_MODE: F1C is 16-bit DDR1; keep VE_MODE
   MEM_TYPE/REC_WR bits at 0 like the BSP does on IC 1663, instead of
   the 32-bit-DDR values cedrus hardcodes.

3. Tiled chroma plane padded to a full 32-line tile row
   (ALIGN(height, 64) / 2, same as mainline). The VE writes whole tile
   rows; the old size under-allocates by 13.8 KiB at 480p and the
   overrun corrupts neighbouring CMA allocations (observed: userspace
   GOT overwritten with pixel data, panics) once buffers pack tightly
   (CMA_ALIGNMENT=4).

4. H264 fixes backported from mainline: slice header bits skipped with
   the FLUSH_BITS trigger instead of the unreliable VE_H264_VLD_OFFSET;
   neighbor_info_buf 32 KiB (not 16); pic_info_buf sized by the CedarX
   formula (fixed 128 KiB is too small).

5. CEDRUS_QUIRK_DBLK_INTRAPRED_DRAM: A13 (0x1625) and suniv (0x1663)
   VEs have no internal SRAM for the H264 deblock/intra-prediction
   context. The BSP blob (libawh264.so H264ConfigTopLeveLRegisters)
   checks exactly these two IC ids and selects the external-DRAM mode
   in VE_BUF_CTRL (0x50) with DRAM buffers in 0x54/0x58. Without this
   each 16-line macroblock row only gets its middle 8 lines written
   (deblock output is lost) and H264 frames come out mostly green.

diff -urN a/drivers/clk/sunxi-ng/ccu-suniv-f1c100s.c b/drivers/clk/sunxi-ng/ccu-suniv-f1c100s.c
--- a/drivers/clk/sunxi-ng/ccu-suniv-f1c100s.c
+++ b/drivers/clk/sunxi-ng/ccu-suniv-f1c100s.c
@@ -309,7 +309,7 @@
 				       0x134, 0, 4, 8, 3, BIT(15), 0);
 
 
-static SUNXI_CCU_GATE(ve_clk, "ve", "pll-ve", 0x13c, BIT(31), 0);
+static SUNXI_CCU_GATE(ve_clk, "ve", "pll-ve", 0x13c, BIT(31), CLK_SET_RATE_PARENT);
 
 static SUNXI_CCU_GATE(codec_clk, "codec", "pll-audio", 0x140, BIT(31), CLK_SET_RATE_PARENT);
 
diff -urN a/drivers/staging/media/sunxi/cedrus/cedrus.c b/drivers/staging/media/sunxi/cedrus/cedrus.c
--- a/drivers/staging/media/sunxi/cedrus/cedrus.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.c
@@ -427,6 +427,12 @@
 	return 0;
 }
 
+static const struct cedrus_variant suniv_f1c100s_cedrus_variant = {
+	.quirks		= CEDRUS_QUIRK_NO_DDR_MODE |
+			  CEDRUS_QUIRK_DBLK_INTRAPRED_DRAM,
+	.mod_rate	= 297000000,
+};
+
 static const struct cedrus_variant sun4i_a10_cedrus_variant = {
 	.mod_rate	= 320000000,
 };
@@ -467,6 +473,10 @@
 
 static const struct of_device_id cedrus_dt_match[] = {
 	{
+		.compatible = "allwinner,suniv-f1c100s-video-engine",
+		.data = &suniv_f1c100s_cedrus_variant,
+	},
+	{
 		.compatible = "allwinner,sun4i-a10-video-engine",
 		.data = &sun4i_a10_cedrus_variant,
 	},
diff -urN a/drivers/staging/media/sunxi/cedrus/cedrus.h b/drivers/staging/media/sunxi/cedrus/cedrus.h
--- a/drivers/staging/media/sunxi/cedrus/cedrus.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.h
@@ -29,6 +29,14 @@
 #define CEDRUS_CAPABILITY_UNTILED	BIT(0)
 
 #define CEDRUS_QUIRK_NO_DMA_OFFSET	BIT(0)
+/* VE_MODE rec-write/DDR-bandwidth bits assume 32-bit DDR; suniv is 16-bit DDR1 */
+#define CEDRUS_QUIRK_NO_DDR_MODE	BIT(1)
+/*
+ * A13 (0x1625) and suniv (0x1663) VEs have no internal SRAM for the H264
+ * deblock/intra-prediction context; the BSP blob always selects the
+ * external-DRAM mode in VE_BUF_CTRL for these ICs.
+ */
+#define CEDRUS_QUIRK_DBLK_INTRAPRED_DRAM	BIT(2)
 
 enum cedrus_codec {
 	CEDRUS_CODEC_MPEG2,
@@ -107,8 +115,15 @@
 			ssize_t		mv_col_buf_size;
 			void		*pic_info_buf;
 			dma_addr_t	pic_info_buf_dma;
+			ssize_t		pic_info_buf_size;
 			void		*neighbor_info_buf;
 			dma_addr_t	neighbor_info_buf_dma;
+			void		*deblk_buf;
+			dma_addr_t	deblk_buf_dma;
+			ssize_t		deblk_buf_size;
+			void		*intra_pred_buf;
+			dma_addr_t	intra_pred_buf_dma;
+			ssize_t		intra_pred_buf_size;
 		} h264;
 	} codec;
 };
@@ -151,6 +166,7 @@
 	struct reset_control	*rstc;
 
 	unsigned int		capabilities;
+	unsigned int		quirks;
 };
 
 extern struct cedrus_dec_ops cedrus_dec_ops_mpeg2;
diff -urN a/drivers/staging/media/sunxi/cedrus/cedrus_h264.c b/drivers/staging/media/sunxi/cedrus/cedrus_h264.c
--- a/drivers/staging/media/sunxi/cedrus/cedrus_h264.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_h264.c
@@ -6,6 +6,7 @@
  * Copyright (c) 2018 Bootlin
  */
 
+#include <linux/delay.h>
 #include <linux/types.h>
 
 #include <media/videobuf2-dma-contig.h>
@@ -37,8 +38,8 @@
 
 #define CEDRUS_H264_FRAME_NUM		18
 
-#define CEDRUS_NEIGHBOR_INFO_BUF_SIZE	(16 * SZ_1K)
-#define CEDRUS_PIC_INFO_BUF_SIZE	(128 * SZ_1K)
+#define CEDRUS_NEIGHBOR_INFO_BUF_SIZE	(32 * SZ_1K)
+#define CEDRUS_MIN_PIC_INFO_BUF_SIZE	(130 * SZ_1K)
 
 static void cedrus_h264_write_sram(struct cedrus_dev *dev,
 				   enum cedrus_h264_sram_off off,
@@ -293,6 +294,28 @@
 	}
 }
 
+/*
+ * It turns out that using VE_H264_VLD_OFFSET to skip bits is not reliable. In
+ * rare cases frames are not decoded properly. However, setting offset to 0 and
+ * skipping appropriate amount of bits with flush bits trigger always works.
+ */
+static void cedrus_skip_bits(struct cedrus_dev *dev, int num)
+{
+	int count = 0;
+
+	while (count < num) {
+		int tmp = min(num - count, 32);
+
+		cedrus_write(dev, VE_H264_TRIGGER_TYPE,
+			     VE_H264_TRIGGER_TYPE_FLUSH_BITS |
+			     VE_H264_TRIGGER_TYPE_N_BITS(tmp));
+		while (cedrus_read(dev, VE_H264_STATUS) & VE_H264_STATUS_VLD_BUSY)
+			udelay(1);
+
+		count += tmp;
+	}
+}
+
 static void cedrus_set_params(struct cedrus_ctx *ctx,
 			      struct cedrus_run *run)
 {
@@ -303,16 +326,14 @@
 	struct vb2_buffer *src_buf = &run->src->vb2_buf;
 	struct cedrus_dev *dev = ctx->dev;
 	dma_addr_t src_buf_addr;
-	u32 offset = slice->header_bit_size;
-	u32 len = (slice->size * 8) - offset;
+	size_t slice_bytes = vb2_get_plane_payload(src_buf, 0);
 	u32 reg;
 
-	cedrus_write(dev, VE_H264_VLD_LEN, len);
-	cedrus_write(dev, VE_H264_VLD_OFFSET, offset);
+	cedrus_write(dev, VE_H264_VLD_LEN, slice_bytes * 8);
+	cedrus_write(dev, VE_H264_VLD_OFFSET, 0);
 
 	src_buf_addr = vb2_dma_contig_plane_dma_addr(src_buf, 0);
-	cedrus_write(dev, VE_H264_VLD_END,
-		     src_buf_addr + vb2_get_plane_payload(src_buf, 0));
+	cedrus_write(dev, VE_H264_VLD_END, src_buf_addr + slice_bytes);
 	cedrus_write(dev, VE_H264_VLD_ADDR,
 		     VE_H264_VLD_ADDR_VAL(src_buf_addr) |
 		     VE_H264_VLD_ADDR_FIRST | VE_H264_VLD_ADDR_VALID |
@@ -327,6 +348,8 @@
 	cedrus_write(dev, VE_H264_TRIGGER_TYPE,
 		     VE_H264_TRIGGER_TYPE_INIT_SWDEC);
 
+	cedrus_skip_bits(dev, slice->header_bit_size);
+
 	if (((pps->flags & V4L2_H264_PPS_FLAG_WEIGHTED_PRED) &&
 	     (slice->slice_type == V4L2_H264_SLICE_TYPE_P ||
 	      slice->slice_type == V4L2_H264_SLICE_TYPE_SP)) ||
@@ -459,6 +482,20 @@
 	cedrus_write(dev, VE_H264_EXTRA_BUFFER2,
 		     ctx->codec.h264.neighbor_info_buf_dma);
 
+	if (dev->quirks & CEDRUS_QUIRK_DBLK_INTRAPRED_DRAM) {
+		cedrus_write(dev, VE_BUF_CTRL,
+			     VE_BUF_CTRL_INTRAPRED_EXT_RAM |
+			     VE_BUF_CTRL_DBLK_EXT_RAM);
+		cedrus_write(dev, VE_DBLK_DRAM_BUF_ADDR,
+			     ctx->codec.h264.deblk_buf_dma);
+		cedrus_write(dev, VE_INTRAPRED_DRAM_BUF_ADDR,
+			     ctx->codec.h264.intra_pred_buf_dma);
+	} else {
+		cedrus_write(dev, VE_BUF_CTRL,
+			     VE_BUF_CTRL_INTRAPRED_INT_SRAM |
+			     VE_BUF_CTRL_DBLK_INT_SRAM);
+	}
+
 	cedrus_write_scaling_lists(ctx, run);
 	cedrus_write_frame_list(ctx, run);
 
@@ -472,14 +509,27 @@
 	unsigned int mv_col_size;
 	int ret;
 
+	unsigned int pic_info_size;
+
+	/* Formula for picture buffer size is taken from CedarX source. */
+
+	if (ctx->src_fmt.width > 2048)
+		pic_info_size = CEDRUS_H264_FRAME_NUM * 0x4000;
+	else
+		pic_info_size = CEDRUS_H264_FRAME_NUM * 0x1000;
+
 	/*
-	 * FIXME: It seems that the H6 cedarX code is using a formula
-	 * here based on the size of the frame, while all the older
-	 * code is using a fixed size, so that might need to be
-	 * changed at some point.
+	 * FIXME: If V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY is set,
+	 * there is no need to multiply by 2.
 	 */
+	pic_info_size += ctx->src_fmt.height * 2 * 64;
+
+	if (pic_info_size < CEDRUS_MIN_PIC_INFO_BUF_SIZE)
+		pic_info_size = CEDRUS_MIN_PIC_INFO_BUF_SIZE;
+
+	ctx->codec.h264.pic_info_buf_size = pic_info_size;
 	ctx->codec.h264.pic_info_buf =
-		dma_alloc_coherent(dev->dev, CEDRUS_PIC_INFO_BUF_SIZE,
+		dma_alloc_coherent(dev->dev, ctx->codec.h264.pic_info_buf_size,
 				   &ctx->codec.h264.pic_info_buf_dma,
 				   GFP_KERNEL);
 	if (!ctx->codec.h264.pic_info_buf)
@@ -532,15 +582,57 @@
 		goto err_neighbor_buf;
 	}
 
+	if (dev->quirks & CEDRUS_QUIRK_DBLK_INTRAPRED_DRAM) {
+		/* Formulas for buffer sizes are taken from CedarX source. */
+
+		ctx->codec.h264.deblk_buf_size =
+			ALIGN(ctx->src_fmt.width, 32) * 12;
+		ctx->codec.h264.deblk_buf =
+			dma_alloc_coherent(dev->dev,
+					   ctx->codec.h264.deblk_buf_size,
+					   &ctx->codec.h264.deblk_buf_dma,
+					   GFP_KERNEL);
+		if (!ctx->codec.h264.deblk_buf) {
+			ret = -ENOMEM;
+			goto err_mv_col_buf;
+		}
+
+		/*
+		 * NOTE: Multiplying by two deviates from CedarX logic, but it
+		 * is for some unknown reason needed for H264 4K decoding on H6.
+		 */
+		ctx->codec.h264.intra_pred_buf_size =
+			ALIGN(ctx->src_fmt.width, 64) * 5 * 2;
+		ctx->codec.h264.intra_pred_buf =
+			dma_alloc_coherent(dev->dev,
+					   ctx->codec.h264.intra_pred_buf_size,
+					   &ctx->codec.h264.intra_pred_buf_dma,
+					   GFP_KERNEL);
+		if (!ctx->codec.h264.intra_pred_buf) {
+			ret = -ENOMEM;
+			goto err_deblk_buf;
+		}
+	}
+
 	return 0;
 
+err_deblk_buf:
+	dma_free_coherent(dev->dev, ctx->codec.h264.deblk_buf_size,
+			  ctx->codec.h264.deblk_buf,
+			  ctx->codec.h264.deblk_buf_dma);
+
+err_mv_col_buf:
+	dma_free_coherent(dev->dev, ctx->codec.h264.mv_col_buf_size,
+			  ctx->codec.h264.mv_col_buf,
+			  ctx->codec.h264.mv_col_buf_dma);
+
 err_neighbor_buf:
 	dma_free_coherent(dev->dev, CEDRUS_NEIGHBOR_INFO_BUF_SIZE,
 			  ctx->codec.h264.neighbor_info_buf,
 			  ctx->codec.h264.neighbor_info_buf_dma);
 
 err_pic_buf:
-	dma_free_coherent(dev->dev, CEDRUS_PIC_INFO_BUF_SIZE,
+	dma_free_coherent(dev->dev, ctx->codec.h264.pic_info_buf_size,
 			  ctx->codec.h264.pic_info_buf,
 			  ctx->codec.h264.pic_info_buf_dma);
 	return ret;
@@ -550,13 +642,21 @@
 {
 	struct cedrus_dev *dev = ctx->dev;
 
+	if (ctx->codec.h264.deblk_buf_size)
+		dma_free_coherent(dev->dev, ctx->codec.h264.deblk_buf_size,
+				  ctx->codec.h264.deblk_buf,
+				  ctx->codec.h264.deblk_buf_dma);
+	if (ctx->codec.h264.intra_pred_buf_size)
+		dma_free_coherent(dev->dev, ctx->codec.h264.intra_pred_buf_size,
+				  ctx->codec.h264.intra_pred_buf,
+				  ctx->codec.h264.intra_pred_buf_dma);
 	dma_free_coherent(dev->dev, ctx->codec.h264.mv_col_buf_size,
 			  ctx->codec.h264.mv_col_buf,
 			  ctx->codec.h264.mv_col_buf_dma);
 	dma_free_coherent(dev->dev, CEDRUS_NEIGHBOR_INFO_BUF_SIZE,
 			  ctx->codec.h264.neighbor_info_buf,
 			  ctx->codec.h264.neighbor_info_buf_dma);
-	dma_free_coherent(dev->dev, CEDRUS_PIC_INFO_BUF_SIZE,
+	dma_free_coherent(dev->dev, ctx->codec.h264.pic_info_buf_size,
 			  ctx->codec.h264.pic_info_buf,
 			  ctx->codec.h264.pic_info_buf_dma);
 }
diff -urN a/drivers/staging/media/sunxi/cedrus/cedrus_hw.c b/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
--- a/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_hw.c
@@ -37,9 +37,13 @@
 	/*
 	 * FIXME: This is only valid on 32-bits DDR's, we should test
 	 * it on the A13/A33.
+	 *
+	 * On suniv (16-bit DDR1) the BSP blob leaves these bits at 0.
 	 */
-	reg |= VE_MODE_REC_WR_MODE_2MB;
-	reg |= VE_MODE_DDR_MODE_BW_128;
+	if (!(dev->quirks & CEDRUS_QUIRK_NO_DDR_MODE)) {
+		reg |= VE_MODE_REC_WR_MODE_2MB;
+		reg |= VE_MODE_DDR_MODE_BW_128;
+	}
 
 	switch (codec) {
 	case CEDRUS_CODEC_MPEG2:
@@ -155,6 +159,7 @@
 		return -EINVAL;
 
 	dev->capabilities = variant->capabilities;
+	dev->quirks = variant->quirks;
 
 	irq_dec = platform_get_irq(dev->pdev, 0);
 	if (irq_dec <= 0)
diff -urN a/drivers/staging/media/sunxi/cedrus/cedrus_regs.h b/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
--- a/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
@@ -37,6 +37,18 @@
 #define VE_MODE_DEC_H264			(0x01 << 0)
 #define VE_MODE_DEC_MPEG			(0x00 << 0)
 
+#define VE_BUF_CTRL				0x50
+
+#define VE_BUF_CTRL_INTRAPRED_EXT_RAM		(0x02 << 2)
+#define VE_BUF_CTRL_INTRAPRED_MIXED_RAM		(0x01 << 2)
+#define VE_BUF_CTRL_INTRAPRED_INT_SRAM		(0x00 << 2)
+#define VE_BUF_CTRL_DBLK_EXT_RAM		(0x02 << 0)
+#define VE_BUF_CTRL_DBLK_MIXED_RAM		(0x01 << 0)
+#define VE_BUF_CTRL_DBLK_INT_SRAM		(0x00 << 0)
+
+#define VE_DBLK_DRAM_BUF_ADDR			0x54
+#define VE_INTRAPRED_DRAM_BUF_ADDR		0x58
+
 #define VE_PRIMARY_CHROMA_BUF_LEN		0xc4
 #define VE_PRIMARY_FB_LINE_STRIDE		0xc8
 
@@ -270,10 +282,13 @@
 					 VE_H264_CTRL_SLICE_DECODE_INT)
 
 #define VE_H264_TRIGGER_TYPE		0x224
+#define VE_H264_TRIGGER_TYPE_N_BITS(x)		(((x) & 0x3f) << 8)
 #define VE_H264_TRIGGER_TYPE_AVC_SLICE_DECODE	(8 << 0)
 #define VE_H264_TRIGGER_TYPE_INIT_SWDEC		(7 << 0)
+#define VE_H264_TRIGGER_TYPE_FLUSH_BITS		(3 << 0)
 
 #define VE_H264_STATUS			0x228
+#define VE_H264_STATUS_VLD_BUSY			BIT(8)
 #define VE_H264_STATUS_VLD_DATA_REQ_INT		VE_H264_CTRL_VLD_DATA_REQ_INT
 #define VE_H264_STATUS_DECODE_ERR_INT		VE_H264_CTRL_DECODE_ERR_INT
 #define VE_H264_STATUS_SLICE_DECODE_INT		VE_H264_CTRL_SLICE_DECODE_INT
diff -urN a/drivers/staging/media/sunxi/cedrus/cedrus_video.c b/drivers/staging/media/sunxi/cedrus/cedrus_video.c
--- a/drivers/staging/media/sunxi/cedrus/cedrus_video.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_video.c
@@ -120,8 +120,12 @@
 		/* Luma plane size. */
 		sizeimage = bytesperline * height;
 
-		/* Chroma plane size. */
-		sizeimage += bytesperline * height / 2;
+		/*
+		 * Chroma plane size: the VE writes whole 32-line tile rows,
+		 * so the chroma plane (height/2) must be padded to a tile
+		 * row boundary or the last tile row lands past the buffer.
+		 */
+		sizeimage += bytesperline * ALIGN(height, 64) / 2;
 
 		break;
 
