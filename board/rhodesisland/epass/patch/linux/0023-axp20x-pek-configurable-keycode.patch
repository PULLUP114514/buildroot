From: Shirogane Tsumugi <artoriapendragon123@gmail.com>
Subject: [PATCH] Input: axp20x-pek - allow overriding the reported keycode

On the ArkEPass-P board the AXP209 PEK line is wired to the panel's
"0" key rather than a real power button, so the fixed KEY_POWER report
is wrong. The pek MFD cell carries no of_node of its own, so read an
optional "x-powers,pek-keycode" from the parent PMIC node and use it
for the edge (press/release) reports. Falls back to KEY_POWER when the
property is absent, preserving the previous behaviour on every other
board.

Signed-off-by: Shirogane Tsumugi <artoriapendragon123@gmail.com>
---
--- a/drivers/input/misc/axp20x-pek.c
+++ b/drivers/input/misc/axp20x-pek.c
@@ -22,6 +22,7 @@
 #include <linux/kernel.h>
 #include <linux/mfd/axp20x.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/regmap.h>
 #include <linux/slab.h>
@@ -50,6 +51,7 @@
 	int irq_dbf;
 	int irq_dbs;
 	int irq_dbl;
+	unsigned int keycode;
 };
 
 struct axp20x_time {
@@ -231,9 +233,9 @@
 	 */
 	if (axp20x_pek->info->pek_type == AXP20X_PEK_EDGE) {
 		if (irq == axp20x_pek->irq_dbf)
-			input_report_key(idev, KEY_POWER, true);
+			input_report_key(idev, axp20x_pek->keycode, true);
 		else if (irq == axp20x_pek->irq_dbr)
-			input_report_key(idev, KEY_POWER, false);
+			input_report_key(idev, axp20x_pek->keycode, false);
 	} else if (axp20x_pek->info->pek_type == AXP20X_PEK_TIME) {
 		if (irq == axp20x_pek->irq_dbs) {
 			input_report_key(idev, KEY_POWER, true);
@@ -340,6 +342,14 @@
 	struct input_dev *idev;
 	int error;
 
+	/*
+	 * The MFD pek cell has no of_node of its own; the keycode override
+	 * lives on the parent PMIC node. Defaults to KEY_POWER when absent.
+	 */
+	axp20x_pek->keycode = KEY_POWER;
+	of_property_read_u32(pdev->dev.parent->of_node, "x-powers,pek-keycode",
+			     &axp20x_pek->keycode);
+
 	if (axp20x_pek->info->pek_type == AXP20X_PEK_EDGE) {
 		error = axp20x_pek_get_edge_irq(axp20x_pek, pdev);
 	} else if (axp20x_pek->info->pek_type == AXP20X_PEK_TIME) {
@@ -359,7 +369,7 @@
 	idev->phys = "m1kbd/input2";
 	idev->dev.parent = &pdev->dev;
 
-	input_set_capability(idev, EV_KEY, KEY_POWER);
+	input_set_capability(idev, EV_KEY, axp20x_pek->keycode);
 	input_set_capability(idev, EV_KEY, KEY_POWER2);
 
 	input_set_drvdata(idev, axp20x_pek);
