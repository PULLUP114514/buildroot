From: Shirogane Tsumugi <artoriapendragon123@gmail.com>
Subject: [PATCH] spi: sun6i: run spi-mem read ops as a single burst

Reading one 2048 byte NAND page takes ~1.13ms on F1C200s, of which only
164us is spent moving data on the wire (dual mode, 50MHz SCLK). Counting
the SPI interrupts over a 512-page read shows why: 5120 of them, ten per
page. The generic spi-mem path emits every op as separate cmd/addr/dummy/
data transfers, and each one costs a full XCH plus an interrupt round trip
-- around 113us each on this 408MHz ARM926. The nine small transfers carry
six bytes between them and account for ~85% of the time.

The controller can do the whole thing in one exchange, which is what the
MTC/STC fields exist for: it sends STC bytes on a single line, then turns
the bus around and clocks in the remainder (over two lines when DRM is
set). The SPL has always read this way (see sunxi_spi0_read_data() in
arch/arm/mach-sunxi/spl_spi_sunxi.c).

Implement mem_ops->exec_op for the read direction, taking a page read from
four transfers to one and a page from ten interrupts to three.

The dummy cycles are emitted as ordinary header bytes rather than through
BCC.DBC. DHB discards TC (i.e. MTC) bytes of echo, so folding the dummy
into the header keeps the discarded count equal to the full header and
leaves the RX FIFO holding the payload alone -- no bounce buffer, and no
dependency on how DBC and DHB interact. This mirrors the SPL, which sends
its 4-byte header the same way.

Writes stay on the generic path: there is no dual TX to exploit, a written
payload would have to share the TX FIFO with the header, and NAND program
throughput is bounded by tPROG anyway. Ops that do not fit (wide cmd/addr,
oversized header, payload past the FIFO with no DMA) return -ENOTSUPP and
the core falls back, so this can only ever be an optimisation.

Signed-off-by: Shirogane Tsumugi <artoriapendragon123@gmail.com>

--- a/drivers/spi/spi-sun6i.c
+++ b/drivers/spi/spi-sun6i.c
@@ -20,10 +20,14 @@
 #include <linux/dmaengine.h>
 
 #include <linux/spi/spi.h>
+#include <linux/spi/spi-mem.h>
 
 #define SUN6I_FIFO_DEPTH		128
 #define SUN8I_FIFO_DEPTH		64
 
+/* Longest cmd + addr + dummy an op may have and still be run as one burst */
+#define SUN6I_OP_HDR_MAX		16
+
 #define SUN6I_GBL_CTL_REG		0x04
 #define SUN6I_GBL_CTL_BUS_ENABLE		BIT(0)
 #define SUN6I_GBL_CTL_MASTER			BIT(1)
@@ -108,6 +112,8 @@
 	const u8		*tx_buf;
 	u8			*rx_buf;
 	int			len;
+	/* Bytes rx_buf can take; the FIFO may hold more if DHB let an echo through */
+	int			rx_len;
 	bool			use_dma;
 	unsigned long		fifo_depth;
 };
@@ -201,11 +207,61 @@
 	sun6i_spi_write(sspi, SUN6I_TFR_CTL_REG, reg);
 }
 
+/*
+ * set_cs() is the callback the SPI core drives, and the core hands it the
+ * inverted level (see spi_set_cs()). exec_op() owns the chip select itself,
+ * so it has to reproduce that inversion rather than call set_cs() directly.
+ */
+static void sun6i_spi_mem_set_cs(struct spi_device *spi, bool activate)
+{
+	bool level = !!(spi->mode & SPI_CS_HIGH);
+
+	sun6i_spi_set_cs(spi, activate ? level : !level);
+}
+
 static size_t sun6i_spi_max_transfer_size(struct spi_device *spi)
 {
 	return SUN6I_MAX_XFER_SIZE - 1;
 }
 
+static void sun6i_spi_setup_clock(struct sun6i_spi *sspi, unsigned int speed_hz)
+{
+	unsigned int mclk_rate, div, div_cdr1, div_cdr2;
+	u32 reg;
+
+	/* Ensure that we have a parent clock fast enough */
+	mclk_rate = clk_get_rate(sspi->mclk);
+	if (mclk_rate < (2 * speed_hz)) {
+		clk_set_rate(sspi->mclk, 2 * speed_hz);
+		mclk_rate = clk_get_rate(sspi->mclk);
+	}
+
+	/*
+	 * Setup clock divider.
+	 *
+	 * We have two choices there. Either we can use the clock
+	 * divide rate 1, which is calculated thanks to this formula:
+	 * SPI_CLK = MOD_CLK / (2 ^ cdr)
+	 * Or we can use CDR2, which is calculated with the formula:
+	 * SPI_CLK = MOD_CLK / (2 * (cdr + 1))
+	 * Wether we use the former or the latter is set through the
+	 * DRS bit.
+	 *
+	 * First try CDR2, and if we can't reach the expected
+	 * frequency, fall back to CDR1.
+	 */
+	div_cdr1 = DIV_ROUND_UP(mclk_rate, speed_hz);
+	div_cdr2 = DIV_ROUND_UP(div_cdr1, 2);
+	if (div_cdr2 <= (SUN6I_CLK_CTL_CDR2_MASK + 1)) {
+		reg = SUN6I_CLK_CTL_CDR2(div_cdr2 - 1) | SUN6I_CLK_CTL_DRS;
+	} else {
+		div = min(SUN6I_CLK_CTL_CDR1_MASK, order_base_2(div_cdr1));
+		reg = SUN6I_CLK_CTL_CDR1(div);
+	}
+
+	sun6i_spi_write(sspi, SUN6I_CLK_CTL_REG, reg);
+}
+
 static void sun6i_spi_dma_rx_cb(void *param)
 {
 	struct sun6i_spi *sspi = param;
@@ -288,7 +344,7 @@
 				  struct spi_transfer *tfr)
 {
 	struct sun6i_spi *sspi = spi_master_get_devdata(master);
-	unsigned int mclk_rate, div, div_cdr1, div_cdr2, timeout;
+	unsigned int timeout;
 	unsigned int start, end, tx_time;
 	unsigned int trig_level;
 	unsigned int tx_len = 0, rx_len = 0;
@@ -304,6 +360,7 @@
 	sspi->tx_buf = tfr->tx_buf;
 	sspi->rx_buf = tfr->rx_buf;
 	sspi->len = tfr->len;
+	sspi->rx_len = tfr->rx_buf ? tfr->len : 0;
 	use_dma = master->can_dma ? master->can_dma(master, spi, tfr) : false;
 	sspi->use_dma = use_dma;
 
@@ -389,37 +446,7 @@
 
 	sun6i_spi_write(sspi, SUN6I_TFR_CTL_REG, reg);
 
-	/* Ensure that we have a parent clock fast enough */
-	mclk_rate = clk_get_rate(sspi->mclk);
-	if (mclk_rate < (2 * tfr->speed_hz)) {
-		clk_set_rate(sspi->mclk, 2 * tfr->speed_hz);
-		mclk_rate = clk_get_rate(sspi->mclk);
-	}
-
-	/*
-	 * Setup clock divider.
-	 *
-	 * We have two choices there. Either we can use the clock
-	 * divide rate 1, which is calculated thanks to this formula:
-	 * SPI_CLK = MOD_CLK / (2 ^ cdr)
-	 * Or we can use CDR2, which is calculated with the formula:
-	 * SPI_CLK = MOD_CLK / (2 * (cdr + 1))
-	 * Wether we use the former or the latter is set through the
-	 * DRS bit.
-	 *
-	 * First try CDR2, and if we can't reach the expected
-	 * frequency, fall back to CDR1.
-	 */
-	div_cdr1 = DIV_ROUND_UP(mclk_rate, tfr->speed_hz);
-	div_cdr2 = DIV_ROUND_UP(div_cdr1, 2);
-	if (div_cdr2 <= (SUN6I_CLK_CTL_CDR2_MASK + 1)) {
-		reg = SUN6I_CLK_CTL_CDR2(div_cdr2 - 1) | SUN6I_CLK_CTL_DRS;
-	} else {
-		div = min(SUN6I_CLK_CTL_CDR1_MASK, order_base_2(div_cdr1));
-		reg = SUN6I_CLK_CTL_CDR1(div);
-	}
-
-	sun6i_spi_write(sspi, SUN6I_CLK_CTL_REG, reg);
+	sun6i_spi_setup_clock(sspi, tfr->speed_hz);
 
 	/* Setup the transfer now... */
 	if (sspi->tx_buf)
@@ -504,6 +531,199 @@
 	return ret;
 }
 
+/*
+ * A read op maps onto a single burst: the controller sends STC bytes on one
+ * line, then turns the bus around and clocks the rest in, optionally over two
+ * lines. Letting the generic spi-mem path split that into four transfers costs
+ * four interrupt round trips, which on this SoC dwarfs the time actually spent
+ * on the wire, so drive the whole op from one exchange instead.
+ *
+ * The dummy cycles are emitted as ordinary header bytes rather than through
+ * BCC.DBC: that keeps the count discarded by DHB (which is MTC) equal to the
+ * whole header, so the RX FIFO ends up holding the payload and nothing else.
+ */
+static int sun6i_spi_exec_op(struct spi_mem *mem, const struct spi_mem_op *op)
+{
+	struct spi_device *spi = mem->spi;
+	struct spi_master *master = spi->master;
+	struct sun6i_spi *sspi = spi_master_get_devdata(master);
+	struct dma_async_tx_descriptor *rxdesc;
+	unsigned int hdr_len, rx_len = 0;
+	unsigned int timeout, tx_time;
+	struct sg_table sgt = { };
+	u8 hdr[SUN6I_OP_HDR_MAX];
+	bool use_dma = false;
+	int i, ret = 0;
+	u32 reg;
+
+	/*
+	 * Only the read direction can be folded into one burst: there is no
+	 * dual TX, and a written payload would have to share the FIFO with the
+	 * header. Everything else falls back to the generic path.
+	 */
+	if (op->cmd.buswidth != 1 || op->data.dir == SPI_MEM_DATA_OUT)
+		return -ENOTSUPP;
+	if (op->addr.nbytes && op->addr.buswidth != 1)
+		return -ENOTSUPP;
+	if (op->dummy.nbytes && op->dummy.buswidth != 1)
+		return -ENOTSUPP;
+
+	hdr_len = sizeof(op->cmd.opcode) + op->addr.nbytes + op->dummy.nbytes;
+	if (hdr_len > sizeof(hdr))
+		return -ENOTSUPP;
+
+	if (op->data.dir == SPI_MEM_DATA_IN) {
+		if (op->data.buswidth != 1 && op->data.buswidth != 2)
+			return -ENOTSUPP;
+		rx_len = op->data.nbytes;
+	}
+
+	if (hdr_len + rx_len > SUN6I_MAX_XFER_SIZE)
+		return -ENOTSUPP;
+
+	/*
+	 * Without DMA the payload would need the RX_RDY watermark interrupts
+	 * the generic path already implements, so leave those ops to it.
+	 */
+	if (rx_len > sspi->fifo_depth) {
+		if (!master->dma_rx)
+			return -ENOTSUPP;
+
+		ret = spi_controller_dma_map_mem_op_data(master, op, &sgt);
+		if (ret)
+			return -ENOTSUPP;
+
+		use_dma = true;
+	}
+
+	hdr[0] = op->cmd.opcode;
+	for (i = 0; i < op->addr.nbytes; i++)
+		hdr[i + 1] = op->addr.val >> (8 * (op->addr.nbytes - i - 1));
+	memset(hdr + 1 + op->addr.nbytes, 0xff, op->dummy.nbytes);
+
+	reinit_completion(&sspi->done);
+	reinit_completion(&sspi->dma_rx_done);
+	sspi->tx_buf = NULL;
+	sspi->rx_buf = rx_len ? op->data.buf.in : NULL;
+	sspi->len = 0;
+	sspi->rx_len = rx_len;
+	sspi->use_dma = use_dma;
+
+	/* Clear pending interrupts */
+	sun6i_spi_write(sspi, SUN6I_INT_STA_REG, ~0);
+
+	/* Reset FIFO */
+	sun6i_spi_write(sspi, SUN6I_FIFO_CTL_REG,
+			SUN6I_FIFO_CTL_RF_RST | SUN6I_FIFO_CTL_TF_RST);
+
+	reg = 0;
+	if (use_dma)
+		reg |= (1 << SUN6I_FIFO_CTL_RF_RDY_TRIG_LEVEL_BITS) |
+		       SUN6I_FIFO_CTL_RF_DRQ_EN;
+	sun6i_spi_write(sspi, SUN6I_FIFO_CTL_REG, reg);
+
+	reg = sun6i_spi_read(sspi, SUN6I_TFR_CTL_REG);
+
+	if (spi->mode & SPI_CPOL)
+		reg |= SUN6I_TFR_CTL_CPOL;
+	else
+		reg &= ~SUN6I_TFR_CTL_CPOL;
+
+	if (spi->mode & SPI_CPHA)
+		reg |= SUN6I_TFR_CTL_CPHA;
+	else
+		reg &= ~SUN6I_TFR_CTL_CPHA;
+
+	if (spi->mode & SPI_LSB_FIRST)
+		reg |= SUN6I_TFR_CTL_FBS;
+	else
+		reg &= ~SUN6I_TFR_CTL_FBS;
+
+	/* Drop what the slave echoed back while the header went out */
+	reg |= SUN6I_TFR_CTL_DHB | SUN6I_TFR_CTL_CS_MANUAL;
+
+	sun6i_spi_write(sspi, SUN6I_TFR_CTL_REG, reg);
+
+	sun6i_spi_setup_clock(sspi, spi->max_speed_hz);
+
+	sun6i_spi_write(sspi, SUN6I_BURST_CNT_REG,
+			SUN6I_BURST_CNT(hdr_len + rx_len));
+	sun6i_spi_write(sspi, SUN6I_XMIT_CNT_REG, SUN6I_XMIT_CNT(hdr_len));
+
+	reg = SUN6I_BURST_CTL_CNT_STC(hdr_len);
+	if (rx_len && op->data.buswidth == 2)
+		reg |= SUN6I_BURST_CTL_CNT_DRM;
+	sun6i_spi_write(sspi, SUN6I_BURST_CTL_CNT_REG, reg);
+
+	for (i = 0; i < hdr_len; i++)
+		writeb(hdr[i], sspi->base_addr + SUN6I_TXDATA_REG);
+
+	if (use_dma) {
+		struct dma_slave_config rxconf = {
+			.direction = DMA_DEV_TO_MEM,
+			.src_addr = sspi->dma_addr_rx,
+			.src_addr_width = DMA_SLAVE_BUSWIDTH_1_BYTE,
+			.src_maxburst = 1,
+		};
+
+		dmaengine_slave_config(master->dma_rx, &rxconf);
+
+		rxdesc = dmaengine_prep_slave_sg(master->dma_rx, sgt.sgl,
+						 sgt.nents, DMA_DEV_TO_MEM,
+						 DMA_PREP_INTERRUPT);
+		if (!rxdesc) {
+			ret = -EINVAL;
+			goto out_unmap;
+		}
+
+		rxdesc->callback_param = sspi;
+		rxdesc->callback = sun6i_spi_dma_rx_cb;
+		dmaengine_submit(rxdesc);
+		dma_async_issue_pending(master->dma_rx);
+	}
+
+	sun6i_spi_write(sspi, SUN6I_INT_CTL_REG, SUN6I_INT_CTL_TC);
+
+	sun6i_spi_mem_set_cs(spi, true);
+
+	reg = sun6i_spi_read(sspi, SUN6I_TFR_CTL_REG);
+	sun6i_spi_write(sspi, SUN6I_TFR_CTL_REG, reg | SUN6I_TFR_CTL_XCH);
+
+	tx_time = max((hdr_len + rx_len) * 8 * 2 /
+		      (spi->max_speed_hz / 1000), 100U);
+	timeout = wait_for_completion_timeout(&sspi->done,
+					      msecs_to_jiffies(tx_time));
+
+	if (use_dma && timeout && rx_len) {
+		timeout = wait_for_completion_timeout(&sspi->dma_rx_done,
+						      timeout);
+		if (!timeout)
+			dev_warn(&master->dev, "RX DMA timeout\n");
+	}
+
+	if (!timeout) {
+		dev_warn(&master->dev, "%s: timeout on %u byte op 0x%02x",
+			 dev_name(&spi->dev), hdr_len + rx_len, op->cmd.opcode);
+		ret = -ETIMEDOUT;
+	}
+
+	sun6i_spi_mem_set_cs(spi, false);
+	sun6i_spi_write(sspi, SUN6I_INT_CTL_REG, 0);
+
+	if (ret && use_dma)
+		dmaengine_terminate_sync(master->dma_rx);
+
+out_unmap:
+	if (use_dma)
+		spi_controller_dma_unmap_mem_op_data(master, op, &sgt);
+
+	return ret;
+}
+
+static const struct spi_controller_mem_ops sun6i_spi_mem_ops = {
+	.exec_op = sun6i_spi_exec_op,
+};
+
 static irqreturn_t sun6i_spi_handler(int irq, void *dev_id)
 {
 	struct sun6i_spi *sspi = dev_id;
@@ -517,7 +737,7 @@
 		 * draining it here would race with it and corrupt data.
 		 */
 		if (!sspi->use_dma)
-			sun6i_spi_drain_fifo(sspi, sspi->fifo_depth);
+			sun6i_spi_drain_fifo(sspi, sspi->rx_len);
 		complete(&sspi->done);
 		return IRQ_HANDLED;
 	}
@@ -653,6 +873,7 @@
 	master->min_speed_hz = 3 * 1000;
 	master->set_cs = sun6i_spi_set_cs;
 	master->transfer_one = sun6i_spi_transfer_one;
+	master->mem_ops = &sun6i_spi_mem_ops;
 	master->num_chipselect = 4;
 	master->mode_bits = SPI_CPOL | SPI_CPHA | SPI_CS_HIGH | SPI_LSB_FIRST |
 			    SPI_RX_DUAL;
