+	*has_vmin = of_property_read_bool(np, "voltage-min-design-microvolt");
+	*has_vmax = of_property_read_bool(np, "voltage-max-design-microvolt");
+	*has_ocv = of_find_property(np, "ocv-capacity-table-0", NULL) != NULL;
+	of_node_put(np);
