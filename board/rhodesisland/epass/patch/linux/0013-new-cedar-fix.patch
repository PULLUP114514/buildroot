+static void cedardev_free_iommu_buffer(struct cedarv_iommu_buffer *buf)
+{
+	if (!buf)
+		return;
+
+	if (!IS_ERR_OR_NULL(buf->dma_buf)) {
+		if (!IS_ERR_OR_NULL(buf->attachment)) {
+			if (!IS_ERR_OR_NULL(buf->sgt))
+				dma_buf_unmap_attachment(buf->attachment,
+							  buf->sgt,
+							  DMA_BIDIRECTIONAL);
+			dma_buf_detach(buf->dma_buf, buf->attachment);
+		}
+		dma_buf_put(buf->dma_buf);
+	}
+
+	kfree(buf);
+}
+
+static int cedardev_map_dma_buf(int fd, unsigned int *addr, struct file *filp)
+{
+	struct cedarv_iommu_buffer *buf;
+
+	buf = kzalloc(sizeof(*buf), GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	buf->fd = fd;
+	buf->dma_buf = dma_buf_get(fd);
+	if (IS_ERR(buf->dma_buf)) {
+		dev_err(cedar_devp->platform_dev, "ve get dma_buf error\n");
+		goto err;
+	}
+
+	buf->attachment = dma_buf_attach(buf->dma_buf,
+					 cedar_devp->platform_dev);
+	if (IS_ERR(buf->attachment)) {
+		dev_err(cedar_devp->platform_dev,
+			"ve get dma_buf_attachment error\n");
+		goto err;
+	}
+
+	buf->sgt = dma_buf_map_attachment(buf->attachment,
+					  DMA_BIDIRECTIONAL);
+	if (IS_ERR(buf->sgt)) {
+		dev_err(cedar_devp->platform_dev, "ve get sg_table error\n");
+		goto err;
+	}
+
+	buf->iommu_addr = sg_dma_address(buf->sgt->sgl);
+	buf->p_id = current->tgid;
+	buf->filp = filp;
+	*addr = (unsigned int)(buf->iommu_addr & 0xffffffff);
+
+	dev_dbg(cedar_devp->platform_dev,
+		"map fd:%d, iommu_addr:%lx, dma_buf:%p, attachment:%p, sgt:%p, nents:%d, pid:%d\n",
+		buf->fd, buf->iommu_addr, buf->dma_buf, buf->attachment,
+		buf->sgt, buf->sgt->nents, buf->p_id);
+
+	mutex_lock(&cedar_devp->lock_mem);
+	aw_mem_list_add_tail(&buf->i_list, &cedar_devp->list);
+	mutex_unlock(&cedar_devp->lock_mem);
+
+	return 0;
+
+err:
+	cedardev_free_iommu_buffer(buf);
+	return -EFAULT;
+}
+
+static int cedardev_unmap_dma_buf(int fd, pid_t pid, struct file *filp)
+{
+	struct aw_mem_list_head *pos, *q;
+	struct cedarv_iommu_buffer *buf;
+	int found = 0;
+
+	mutex_lock(&cedar_devp->lock_mem);
+	aw_mem_list_for_each_safe(pos, q, &cedar_devp->list) {
+		buf = aw_mem_list_entry(pos, struct cedarv_iommu_buffer,
+					i_list);
+		if (buf->fd != fd || buf->p_id != pid || buf->filp != filp)
+			continue;
+
+		aw_mem_list_del(&buf->i_list);
+		found = 1;
+		mutex_unlock(&cedar_devp->lock_mem);
+		cedardev_free_iommu_buffer(buf);
+		return 0;
+	}
+	mutex_unlock(&cedar_devp->lock_mem);
+
+	return found ? 0 : -ENOENT;
+}
+
+static void cedardev_unmap_dma_buf_by_filp(struct file *filp)
+{
+	struct aw_mem_list_head *pos, *q;
+	struct cedarv_iommu_buffer *buf;
+
+	for (;;) {
+		buf = NULL;
+		mutex_lock(&cedar_devp->lock_mem);
+		aw_mem_list_for_each_safe(pos, q, &cedar_devp->list) {
+			buf = aw_mem_list_entry(pos, struct cedarv_iommu_buffer,
+						i_list);
+			if (buf->filp != filp) {
+				buf = NULL;
+				continue;
+			}
+
+			aw_mem_list_del(&buf->i_list);
+			break;
+		}
+		mutex_unlock(&cedar_devp->lock_mem);
+
+		if (!buf)
+			break;
+
+		cedardev_free_iommu_buffer(buf);
+	}
+}
