+static void cedardev_apply_f1c_ccu_hack(int mode)
+{
+	struct device_node *ccu_np;
+	void __iomem *ccu_base;
+	u32 val;
+
+	if (mode == CEDAR_CCU_HACK_NONE)
+		return;
+
+	ccu_np = of_find_compatible_node(NULL, NULL,
+					 "allwinner,suniv-f1c100s-ccu");
+	if (!ccu_np) {
+		dev_warn(cedar_devp->platform_dev,
+			 "could not find suniv ccu node for cedar hack\n");
+		return;
+	}
+
+	ccu_base = of_iomap(ccu_np, 0);
+	of_node_put(ccu_np);
+	if (!ccu_base) {
+		dev_warn(cedar_devp->platform_dev,
+			 "could not map suniv ccu node for cedar hack\n");
+		return;
+	}
+
+	val = readl(ccu_base + 0x18);
+	val &= 0x7fff80f0;
+	if (mode == CEDAR_CCU_HACK_SUNIVW1P1)
+		val |= (1 << 31) | (8 << 8);
+	else if (mode == CEDAR_CCU_HACK_SUN3IW1P1)
+		val |= (1 << 31) | (49 << 8) | (3 << 0);
+	writel(val, ccu_base + 0x18);
+	readl(ccu_base + 0x18);
+	udelay(10);
+
+	/* Keep the BSP ordering: module clock, AHB, reset, then SDRAM bus. */
+	val = readl(ccu_base + 0x13c);
+	val |= (1 << 31);
+	writel(val, ccu_base + 0x13c);
+	readl(ccu_base + 0x13c);
+	udelay(10);
+
+	val = readl(ccu_base + 0x64);
+	val |= (1 << 0);
+	writel(val, ccu_base + 0x64);
+	readl(ccu_base + 0x64);
+	udelay(10);
+
+	val = readl(ccu_base + 0x2c4);
+	val &= ~(1 << 0);
+	writel(val, ccu_base + 0x2c4);
+	readl(ccu_base + 0x2c4);
+	udelay(10);
+
+	val = readl(ccu_base + 0x2c4);
+	val |= (1 << 0);
+	writel(val, ccu_base + 0x2c4);
+	readl(ccu_base + 0x2c4);
+	usleep_range(1000, 2000);
+
+	val = readl(ccu_base + 0x100);
+	val |= (1 << 0);
+	writel(val, ccu_base + 0x100);
+	readl(ccu_base + 0x100);
+	udelay(10);
+
+	iounmap(ccu_base);
+	dev_info(cedar_devp->platform_dev,
+		 "applied F1C cedar CCU hack mode %d\n", mode);
+}
+
+static void cedardev_apply_f1c_sram_hack(int mode)
+{
+	struct device_node *syscon_np;
+	void __iomem *syscon_base;
+	u32 val;
+
+	if (mode == CEDAR_CCU_HACK_NONE)
+		return;
+
+	syscon_np = of_find_compatible_node(NULL, NULL,
+					    "allwinner,sun4i-a10-system-control");
+	if (!syscon_np) {
+		dev_warn(cedar_devp->platform_dev,
+			 "could not find syscon node for F1C SRAM hack\n");
+		return;
+	}
+
+	syscon_base = of_iomap(syscon_np, 0);
+	of_node_put(syscon_np);
+	if (!syscon_base) {
+		dev_warn(cedar_devp->platform_dev,
+			 "could not map syscon node for F1C SRAM hack\n");
+		return;
+	}
+
+	/* Tina toggles the SRAM C1 mapping after the VE CCU path is enabled. */
+	val = readl(syscon_base + 0x0);
+	val &= 0x80000000;
+	writel(val, syscon_base + 0x0);
+	readl(syscon_base + 0x0);
+	udelay(10);
+
+	val = readl(syscon_base + 0x0);
+	val |= 0x7fffffff;
+	writel(val, syscon_base + 0x0);
+	readl(syscon_base + 0x0);
+	udelay(10);
+
+	val = readl(syscon_base + 0x4);
+	val &= ~(BIT(24) | BIT(28));
+	writel(val, syscon_base + 0x4);
+	readl(syscon_base + 0x4);
+	udelay(10);
+
+	iounmap(syscon_base);
+	dev_info(cedar_devp->platform_dev,
+		 "applied F1C cedar SRAM remap sequence\n");
+}
+
+static void cedardev_dump_f1c_ccu_sys(const char *tag)
+{
+	struct device_node *ccu_np;
+	struct device_node *syscon_np;
+	void __iomem *ccu_base = NULL;
+	void __iomem *syscon_base = NULL;
+
+	if (cedar_devp->ccu_hack_mode == CEDAR_CCU_HACK_NONE)
+		return;
+
+	ccu_np = of_find_compatible_node(NULL, NULL,
+					 "allwinner,suniv-f1c100s-ccu");
+	if (ccu_np) {
+		ccu_base = of_iomap(ccu_np, 0);
+		of_node_put(ccu_np);
+	}
+
+	syscon_np = of_find_compatible_node(NULL, NULL,
+					    "allwinner,sun4i-a10-system-control");
+	if (syscon_np) {
+		syscon_base = of_iomap(syscon_np, 0);
+		of_node_put(syscon_np);
+	}
+
+	if (ccu_base)
+		dev_info(cedar_devp->platform_dev,
+			 "F1C %s CCU: pll_ve=%08x ahb=%08x dram=%08x ve=%08x reset=%08x\n",
+			 tag,
+			 readl(ccu_base + 0x18),
+			 readl(ccu_base + 0x64),
+			 readl(ccu_base + 0x100),
+			 readl(ccu_base + 0x13c),
+			 readl(ccu_base + 0x2c4));
+	else
+		dev_warn(cedar_devp->platform_dev,
+			 "F1C %s CCU: could not map ccu registers\n", tag);
+
+	if (syscon_base)
+		dev_info(cedar_devp->platform_dev,
+			 "F1C %s SYS: sram0=%08x sram1=%08x\n",
+			 tag, readl(syscon_base + 0x0),
+			 readl(syscon_base + 0x4));
+	else
+		dev_warn(cedar_devp->platform_dev,
+			 "F1C %s SYS: could not map syscon registers\n", tag);
+
+	if (syscon_base)
+		iounmap(syscon_base);
+	if (ccu_base)
+		iounmap(ccu_base);
+}
+
+static void cedardev_prepare_f1c_bsp_idle_state(void)
+{
+	if (cedar_devp->ccu_hack_mode == CEDAR_CCU_HACK_NONE)
+		return;
+
+	/*
+	 * Tina 3.10 leaves VE reset asserted after probe and only keeps the
+	 * module clock prepared. ENGINE_REQ then deasserts reset and enables
+	 * the clock. Mirror that state for F1C after the manual CCU/SRAM setup.
+	 */
+	clk_disable(cedar_devp->mod_clk);
+	reset_control_assert(cedar_devp->rstc);
+	clk_status = 0;
+
+	dev_info(cedar_devp->platform_dev,
+		 "prepared F1C VE BSP-style idle state\n");
+	cedardev_dump_f1c_ccu_sys("probe-idle");
+}
