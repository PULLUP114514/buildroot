+static void cedardev_dump_h264_regs(const char *tag)
+{
+	u32 off;
+	u32 val0;
+	u32 val1;
+	u32 val2;
+	u32 val3;
+
+	dev_warn(cedar_devp->platform_dev,
+		 "VE %s top: ctrl=%08x reset=%08x status=%08x version=%08x\n",
+		 tag,
+		 readl(cedar_devp->regs_macc + 0x0),
+		 readl(cedar_devp->regs_macc + 0x4),
+		 readl(cedar_devp->regs_macc + 0x1c),
+		 readl(cedar_devp->regs_macc + 0xf0));
+	for (off = 0x200; off <= 0x230; off += 0x10) {
+		dev_warn(cedar_devp->platform_dev,
+			 "VE %s H264 regs %03x: %08x %08x %08x %08x\n",
+			 tag, off,
+			 readl(cedar_devp->regs_macc + off),
+			 readl(cedar_devp->regs_macc + off + 0x4),
+			 readl(cedar_devp->regs_macc + off + 0x8),
+			 readl(cedar_devp->regs_macc + off + 0xc));
+	}
+
+	for (off = 0; off < 0x1000; off += 0x10) {
+		val0 = readl(cedar_devp->regs_macc + off);
+		val1 = readl(cedar_devp->regs_macc + off + 0x4);
+		val2 = readl(cedar_devp->regs_macc + off + 0x8);
+		val3 = readl(cedar_devp->regs_macc + off + 0xc);
+		if (val0 || val1 || val2 || val3)
+			dev_warn(cedar_devp->platform_dev,
+				 "VE %s nonzero %03x: %08x %08x %08x %08x\n",
+				 tag, off, val0, val1, val2, val3);
+	}
+}
