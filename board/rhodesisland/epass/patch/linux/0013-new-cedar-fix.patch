+static void cedardev_clear_bootmode_map(void)
+{
+	struct device_node *syscon_np;
+	void __iomem *syscon_base;
+	u32 val;
+
+	syscon_np = of_find_compatible_node(NULL, NULL,
+					    "allwinner,sun4i-a10-system-control");
+	if (!syscon_np)
+		return;
+
+	syscon_base = of_iomap(syscon_np, 0);
+	of_node_put(syscon_np);
+	if (!syscon_base)
+		return;
+
+	val = readl(syscon_base + 0x4);
+	if (val & (BIT(24) | BIT(28))) {
+		writel(val & ~(BIT(24) | BIT(28)), syscon_base + 0x4);
+		dev_info(cedar_devp->platform_dev,
+			 "cleared SRAM bootmode map bit for VE access\n");
+	}
+
+	iounmap(syscon_base);
+}
