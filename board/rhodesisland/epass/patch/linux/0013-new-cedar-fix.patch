+static int cedardev_check_de_irq_status(void)
+{
+	void __iomem *status_reg;
+	void __iomem *ctrl_reg;
+	u32 mod_sel;
+	u32 status;
+	u32 ctrl;
+	u32 mask;
+
+	mod_sel = readl(cedar_devp->regs_macc + 0);
+	switch (mod_sel & 0xf) {
+	case 0: /* mpeg124 */
+		status_reg = cedar_devp->regs_macc + 0x100 + 0x1c;
+		ctrl_reg = cedar_devp->regs_macc + 0x100 + 0x14;
+		mask = 0x7c;
+		break;
+	case 1: /* h264 */
+		status_reg = cedar_devp->regs_macc + 0x200 + 0x28;
+		ctrl_reg = cedar_devp->regs_macc + 0x200 + 0x20;
+		mask = 0xf;
+		break;
+	case 2: /* vc1 */
+		status_reg = cedar_devp->regs_macc + 0x300 + 0x2c;
+		ctrl_reg = cedar_devp->regs_macc + 0x300 + 0x24;
+		mask = 0xf;
+		break;
+	case 3: /* rv */
+		status_reg = cedar_devp->regs_macc + 0x400 + 0x1c;
+		ctrl_reg = cedar_devp->regs_macc + 0x400 + 0x14;
+		mask = 0xf;
+		break;
+	case 4: /* hevc */
+		status_reg = cedar_devp->regs_macc + 0x500 + 0x38;
+		ctrl_reg = cedar_devp->regs_macc + 0x500 + 0x30;
+		mask = 0xf;
+		break;
+	default:
+		dev_warn(cedar_devp->platform_dev,
+			 "VE DE timeout: unsupported mod_sel=0x%x top04=0x%x\n",
+			 mod_sel, readl(cedar_devp->regs_macc + 0x4));
+		return 0;
+	}
+
+	status = readl(status_reg);
+	ctrl = readl(ctrl_reg);
+	if (status & mask) {
+		writel(ctrl & ~mask, ctrl_reg);
+		dev_warn(cedar_devp->platform_dev,
+			 "VE DE IRQ missed: mod_sel=0x%x status=0x%x ctrl=0x%x top04=0x%x\n",
+			 mod_sel, status, ctrl, readl(cedar_devp->regs_macc + 0x4));
+		return 1;
+	}
+
+	dev_warn(cedar_devp->platform_dev,
+		 "VE DE timeout: mod_sel=0x%x status=0x%x ctrl=0x%x top04=0x%x h264_trig=0x%x h264_status=0x%x\n",
+		 mod_sel, status, ctrl, readl(cedar_devp->regs_macc + 0x4),
+		 readl(cedar_devp->regs_macc + 0x200 + 0x24),
+		 readl(cedar_devp->regs_macc + 0x200 + 0x28));
+	if ((mod_sel & 0xf) == 1)
+		cedardev_dump_h264_regs("timeout");
+	return 0;
+}
