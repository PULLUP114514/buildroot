    fragment@2 {
        target = <&panel>;
        __overlay__ {
            compatible = "lattland,hsd-nv3052", "simple-panel";
        };
    };

    fragment@3 {
        target = <&tcon0>;
        __overlay__ {
            srgn,swap-b-r;
        };
    };
