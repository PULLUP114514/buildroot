                ST7701INIT_WRITE_C8_D8 0xFF 0x52
                ST7701INIT_WRITE_C8_D8 0xFF 0x00
                /* ST7701INIT_WRITE_C8_D8 0x3A 0x50   补: 16-bit RGB565 (vendor 缺, 默认 24-bit) */
                ST7701INIT_WRITE_C8_D8 0x36 0x0A
                ST7701INIT_WRITE_COMMAND_8 0x11    /* sleep out */
                ST7701INIT_END_WRITE

                ST7701INIT_DELAY 200

                ST7701INIT_BEGIN_WRITE
                ST7701INIT_WRITE_COMMAND_8 0x29    /* display on */
                ST7701INIT_END_WRITE

                ST7701INIT_DELAY 100
            >;
        };
