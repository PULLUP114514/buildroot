                ST7701INIT_WRITE_C8_D8 0xA5 0x05
                ST7701INIT_WRITE_C8_D8 0xB0 0x00
                ST7701INIT_WRITE_C8_D8 0xB1 0x1F
                ST7701INIT_WRITE_C8_D8 0xB2 0x16
