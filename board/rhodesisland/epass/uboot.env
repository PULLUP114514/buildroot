kernaddr=0x80008000
dtbaddr=0x80C00000
dtboaddr=0x80D00000
envtxtaddr=0x80E00000
fitaddr=0x81000000
fbaddr=0x81500000

rundfu=mtd erase spi-nand0 0x100000 0x7E00000; \
    setenv dfu_alt_info "uboot part 1;boot part 2;rootfs partubi 3"; \
    dfu 0 mtd spi-nand0; \
    sleep 1; \
    dfu 0 mtd spi-nand0; \
    run distro_bootcmd;

load1env=mtd read spi-nand0 ${envtxtaddr} 0xFA000 0x6000; \
    env import -t ${envtxtaddr};


checkdtbsfit=mtd read spi-nand0 $fitaddr 0x100000 0x800; \
    if fdt addr $fitaddr; then \
        fdt header get dtbsfitsize totalsize; \
        if itest $dtbsfitsize -gt 0x100000; then setenv dtbsfitsize 0; fi; \
    else \
        setenv dtbsfitsize 0; \
    fi


loaddtbsfit=run checkdtbsfit; \
    if itest $dtbsfitsize -eq 0; then \
        echo "DTBs FIT header invalid, going DFU"; run rundfu; \
    fi; \
    mtd read spi-nand0 $fitaddr 0x100000 $dtbsfitsize; \
    if fdt addr $fitaddr; then \
        true; \
    else \
        echo "DTBs FIT not valid after read, going DFU"; run rundfu; \
    fi

checkkernelfit=mtd read spi-nand0 $fitaddr 0x200000 0x800; \
    if fdt addr $fitaddr; then \
        fdt header get kernelfitsize totalsize; \
        if itest $kernelfitsize -gt 0x500000; then setenv kernelfitsize 0; fi; \
    else \
        setenv kernelfitsize 0; \
    fi

loadkernelfit=run checkkernelfit; \
    if itest $kernelfitsize -eq 0; then \
        echo "Kernel FIT header invalid, going DFU"; run rundfu; \
    fi; \
    mtd read spi-nand0 $fitaddr 0x200000 $kernelfitsize; \
    if fdt addr $fitaddr; then \
        true; \
    else \
        echo "Kernel FIT not valid after read, going DFU"; run rundfu; \
    fi

loaddtbs=run loaddtbsfit; \
    imxtract $fitaddr fdt-base-${device_rev} $dtbaddr; \
    imxtract $fitaddr fdt-screen-${screen} $dtboaddr;

loadkernel=run loadkernelfit; \
    imxtract $fitaddr kernel $kernaddr;

patchbasic=fdt addr $dtbaddr; fdt resize 32768; fdt apply $dtboaddr;
patchinterface=for ov in ${interface}; do echo Applying Interface ${ov}...; imxtract $fitaddr fdt-iface-${ov} $dtboaddr; fdt apply $dtboaddr; done;
patchext=for ov in ${ext}; do echo Applying extension ${ov}...; imxtract $fitaddr fdt-ext-${ov} $dtboaddr; fdt apply $dtboaddr; done;

panelinit=srgn_st7701init ${dtbaddr};

splash=if imxtract ${fitaddr} logo-${screen} ${fbaddr}; then srgn_splash ${dtbaddr} ${fbaddr}; fi;
splashargs=if test -n "${splash_active}"; then setenv bootargs "${bootargs} clk_ignore_unused"; fi;

ensurecmdline=if test -z "$bootargs"; then setenv bootargs "console=ttyS0,115200 panic=5 rootwait mtdparts=spi0.0:1M(u-boot)ro,6M(boot),-(rootfs) root=ubi0:rootfs earlyprintk rw rootfstype=ubifs ubi.mtd=2 ubi.fm_autoconvert=1"; fi
distro_bootcmd=run load1env; run loaddtbs; run patchbasic; run patchinterface; run patchext; run panelinit; run splash; run loadkernel; run ensurecmdline; run splashargs; bootz $kernaddr - $dtbaddr; run rundfu;