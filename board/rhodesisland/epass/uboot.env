kernaddr=0x80008000
dtbaddr=0x80C00000
dtboaddr=0x80D00000
envtxtaddr=0x80E00000
fitaddr=0x81000000

rundfu=mtd erase spi-nand0 0x100000 0x7E00000; \
    setenv dfu_alt_info "uboot part 1;boot part 2;rootfs partubi 3"; \
    dfu 0 mtd spi-nand0; \
    sleep 1; \
    dfu 0 mtd spi-nand0; \
    run distro_bootcmd;

load1env=mtd read spi-nand0 ${envtxtaddr} 0xFA000 0x6000; \
    env import -t ${envtxtaddr};


checkfit=mtd read spi-nand0 $fitaddr 0x100000 0x800; \
    if fdt addr $fitaddr; then \
        fdt header get fitsize totalsize; \
        if itest $fitsize -gt 0x500000; then setenv fitsize 0; fi; \
    else \
        setenv fitsize 0; \
    fi


loadfit=run checkfit; \
    if itest $fitsize -eq 0; then \
        echo "FIT header invalid, going DFU"; run rundfu; \
    fi; \
    mtd read spi-nand0 $fitaddr 0x100000 $fitsize; \
    if fdt addr $fitaddr; then \
        true; \
    else \
        echo "FIT not valid after read, going DFU"; run rundfu; \
    fi

loadbasic=run loadfit; \
    imxtract $fitaddr kernel $kernaddr; \
    imxtract $fitaddr fdt-base-${device_rev} $dtbaddr; \
    imxtract $fitaddr fdt-screen-${screen} $dtboaddr;

patchbasic=fdt addr $dtbaddr; fdt resize 32768; fdt apply $dtboaddr;
patchinterface=for ov in ${interface}; do echo Applying Interface ${ov}...; imxtract $fitaddr fdt-iface-${ov} $dtboaddr; fdt apply $dtboaddr; done;
patchext=for ov in ${ext}; do echo Applying extension ${ov}...; imxtract $fitaddr fdt-ext-${ov} $dtboaddr; fdt apply $dtboaddr; done;

ensurecmdline=if test -z "$bootargs"; then setenv bootargs "console=ttyS0,115200 panic=5 rootwait mtdparts=spi0.0:1M(u-boot)ro,6M(boot),-(rootfs) root=ubi0:rootfs earlyprintk rw rootfstype=ubifs ubi.mtd=2 ubi.fm_autoconvert=1"; fi
distro_bootcmd=run load1env; run loadbasic; run patchbasic; run patchinterface; run patchext; run ensurecmdline; bootz $kernaddr - $dtbaddr; run rundfu;