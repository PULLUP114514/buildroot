config BR2_PACKAGE_DRMTEST
	bool "drmtest"
	depends on BR2_TOOLCHAIN_HAS_THREADS # libdrm
	select BR2_PACKAGE_LIBDRM
	help
	  DRM/KMS screen pattern tester (fbtest equivalent for
	  modern DRM). Draws SMPTE bars, gradients, grids and
	  solid colors via legacy KMS + dumb buffers.

comment "drmtest needs a toolchain w/ threads"
	depends on !BR2_TOOLCHAIN_HAS_THREADS
